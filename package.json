{
  "name": "luxia-key",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && tsc -p tsconfig.api.json && node scripts/copy-migrations.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json --noEmit",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:security",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "tsx services/api/migrate.ts",
    "api": "tsx services/api/index.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "cbor-x": "^1.6.6",
    "eslint": "10.12.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.x"
  }
}
